      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://vernia-uncalcined-alfonso.ngrok-free.dev/api/v1"
      },
      "android": {
